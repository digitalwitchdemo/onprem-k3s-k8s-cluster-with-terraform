# ---- Argo CD at https://<argocd_hostname> through the NGINX ingress ----
# Terraform installs Argo CD only. The Ingress is created MANUALLY from
# manifests/argocd-ingress.yaml once the DNS A record points at the master's
# public IP. TLS is terminated at NGINX with a Let's Encrypt certificate that
# cert-manager issues for that Ingress.
resource "helm_release" "argocd" {
  name             = "argocd"
  repository       = "https://argoproj.github.io/argo-helm"
  chart            = "argo-cd"
  version          = "10.10.1"
  namespace        = "argocd"
  create_namespace = true

  values = [yamlencode({
    global = {
      domain = var.argocd_hostname
    }

    configs = {
      params = {
        # NGINX terminates TLS, so argocd-server serves plain HTTP inside the cluster
        "server.insecure" = true
      }
    }

    server = {
      ingress = {
        # The chart does NOT create the Ingress. Create it yourself after the DNS
        # A record exists: kubectl apply -f manifests/argocd-ingress.yaml
        enabled = false
      }
    }
  })]

  depends_on = [
    helm_release.nginx_ingress,
    helm_release.cluster_issuer,
  ]
}

# Initial admin password generated by Argo CD on first install
data "kubernetes_secret_v1" "argocd_initial_admin" {
  metadata {
    name      = "argocd-initial-admin-secret"
    namespace = helm_release.argocd.namespace
  }

  depends_on = [helm_release.argocd]
}
